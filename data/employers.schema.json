{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workathill.com/employers.schema.json",
  "title": "Work At Hill employers",
  "type": "object",
  "required": ["bases", "employers"],
  "additionalProperties": false,
  "properties": {
    "bases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "state", "path"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "path": { "type": "string", "pattern": "^/([a-z0-9-]+/)*$" }
        }
      }
    },
    "employers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "base", "name", "type", "description", "categories", "jobsUrl", "secondaryUrl", "verified", "sourceUrl"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "base": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "type": { "enum": ["prime", "subcontractor", "federal", "services"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 120 },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": ["trades-maintenance", "engineering", "software-it", "logistics-supply", "admin-business", "internships-entry", "base-services"]
            }
          },
          "jobsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "secondaryUrl": { "type": ["string", "null"], "pattern": "^https://[^\\s]+$" },
          "verified": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
          "sourceUrl": { "type": "string", "pattern": "^https://[^\\s]+$" }
        }
      }
    }
  }
}
